@startuml
title Smart Home - ER Diagram (Logical Data Model)

!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml

Package "User Service DB" {

  entity "users" as users {
    *id : UUID <<PK>>
    --
    email : VARCHAR(255) <<UK>>
    password_hash : VARCHAR(255)
    name : VARCHAR(100)
    phone : VARCHAR(20)
    role : VARCHAR(20)
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
    last_login : TIMESTAMP
  }

  entity "houses" as houses {
    *id : UUID <<PK>>
    --
    user_id : UUID <<FK>>
    name : VARCHAR(100)
    address : TEXT
    city : VARCHAR(100)
    country : VARCHAR(50)
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
  }

  entity "user_devices" as user_devices {
    *id : UUID <<PK>>
    --
    user_id : UUID <<FK>>
    device_id : UUID <<FK>>
    role : VARCHAR(20)
    added_at : TIMESTAMP
  }
}

Package "Device Service DB" {

  entity "devices" as devices {
    *id : UUID <<PK>>
    --
    name : VARCHAR(100)
    type_id : UUID <<FK>>
    model : VARCHAR(100)
    manufacturer : VARCHAR(100)
    serial_number : VARCHAR(50) <<UK>>
    firmware_version : VARCHAR(20)
    location : VARCHAR(100)
    status : VARCHAR(20)
    is_online : BOOLEAN
    user_id : UUID
    registered_at : TIMESTAMP
    updated_at : TIMESTAMP
  }

  entity "device_types" as device_types {
    *id : UUID <<PK>>
    --
    name : VARCHAR(50) <<UK>>
    description : TEXT
    protocol : VARCHAR(20)
    category : VARCHAR(50)
    icon : VARCHAR(50)
  }

  entity "device_status_history" as device_status_history {
    *id : UUID <<PK>>
    --
    device_id : UUID <<FK>>
    old_status : VARCHAR(20)
    new_status : VARCHAR(20)
    changed_at : TIMESTAMP
    reason : TEXT
  }

Package "Metrics Service DB" {

  entity "metrics" as metrics {
    *id : UUID <<PK>>
    --
    device_id : UUID
    sensor_id : UUID
    metric_type : VARCHAR(50)
    value : DECIMAL(10,2)
    unit : VARCHAR(20)
    timestamp : TIMESTAMP
  }

  entity "sensors" as sensors {
    *id : UUID <<PK>>
    --
    device_id : UUID <<FK>>
    name : VARCHAR(100)
    sensor_type : VARCHAR(50)
    unit : VARCHAR(20)
    location : VARCHAR(100)
    min_value : DECIMAL(10,2)
    max_value : DECIMAL(10,2)
    current_value : DECIMAL(10,2)
    status : VARCHAR(20)
    last_reading_at : TIMESTAMP
    created_at : TIMESTAMP
  }

  entity "alerts" as alerts {
    *id : UUID <<PK>>
    --
    device_id : UUID
    sensor_id : UUID
    alert_type : VARCHAR(50)
    value : DECIMAL(10,2)
    threshold : DECIMAL(10,2)
    severity : VARCHAR(20)
    message : TEXT
    status : VARCHAR(20)
    created_at : TIMESTAMP
    resolved_at : TIMESTAMP
  }

  entity "external_weather" as external_weather {
    *id : UUID <<PK>>
    --
    location : VARCHAR(100)
    temperature : DECIMAL(10,2)
    humidity : DECIMAL(10,2)
    pressure : DECIMAL(10,2)
    conditions : VARCHAR(100)
    fetched_at : TIMESTAMP
  }
}

users ||--o{ houses : "has"
users ||--o{ user_devices : "has"
houses ||--o{ user_devices : "contains"
devices ||--o{ user_devices : "linked_to"

device_types ||--o{ devices : "defines"
devices ||--o{ device_status_history : "has"
devices ||--o{ sensors : "has"

sensors ||--o{ metrics : "generates"
devices ||--o{ alerts : "triggers"
sensors ||--o{ alerts : "triggers"

users }o--|| devices : "owns"
devices }o--|| metrics : "produces"
devices }o--|| alerts : "generates"

@enduml